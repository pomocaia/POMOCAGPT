function onDrop(ev){
  ev.preventDefault();
  document.getElementById('csf-zona').classList.remove('drag');
  var f=ev.dataTransfer.files[0];
  if(f&&f.type==='application/pdf') procesarCSF(f);
}

function procesarCSF(file){
  if(!file) return;
  if(!window.pdfjsLib){
    muestraRes('err','PDF.js no disponible','Verifica tu conexion a internet e intenta de nuevo.');
    return;
  }
  setP(true,'Cargando PDF...',15);
  var reader=new FileReader();
  reader.onload=function(e){
    setP(true,'Extrayendo texto...',45);
    pdfjsLib.getDocument({data:e.target.result}).promise.then(function(doc){
      pdfDoc=doc;
      var texto='';
      var max=Math.min(doc.numPages,4);
      var pags=[];
      for(var i=1;i<=max;i++) pags.push(i);
      var chain=Promise.resolve();
      pags.forEach(function(n){
        chain=chain.then(function(){
          return doc.getPage(n).then(function(pag){
            return pag.getTextContent().then(function(tc){
              texto+=tc.items.map(function(it){return it.str;}).join(' ')+'\n';
            });
          });
        });
      });
      chain.then(function(){
        setP(true,'Analizando...',85);
        if(texto.trim().length<50){
          setP(false,'',100);
          muestraRes('warn','PDF escaneado (sin capa de texto)','Se muestra el PDF para captura manual.');
          document.getElementById('panel-doble').style.display='block';
          renderPag(1);
        } else {
          var d=parsear(texto);
          setP(false,'',100);
          aplicar(d);
        }
      });
    }).catch(function(err){
      setP(false,'',0);
      muestraRes('err','Error al leer el PDF',err.message||'Archivo invalido o protegido.');
    });
  };
  reader.readAsArrayBuffer(file);
}

function setP(vis,txt,pct){
  var el=document.getElementById('csf-prog');
  el.className='csf-progress'+(vis?' vis':'');
  if(vis){
    document.getElementById('prog-bar').style.width=pct+'%';
    document.getElementById('prog-txt').textContent=txt;
  }
}

function parsear(txt){
  var d={};
  var rfcM=txt.match(/\b([A-Z\u00d1&]{3,4}\d{6}[A-Z0-9]{3})\b/);
  if(rfcM) d.rfc=rfcM[1];
  if(d.rfc) d.tipo=d.rfc.length===13?'PF':'PM';
  var curpM=txt.match(/\b([A-Z]{4}\d{6}[HM][A-Z]{5}[A-Z0-9]\d)\b/);
  if(curpM) d.curp=curpM[1];
  var nomM=txt.match(/(?:Nombre\s*:|Nombre del contribuyente\s*:?|Raz[o\u00f3]n [Ss]ocial\s*:?)\s*([A-Z\u00c1\u00c9\u00cd\u00d3\u00da\u00d1][^\n\r,]{3,80})/i);
  if(nomM) d.nombre=nomM[1].replace(/\s+/g,' ').trim().substring(0,80);
  var cpM=txt.match(/\b(\d{5})\b/);
  if(cpM) d.cp=cpM[1];
  d.regimenes=[];
  if(/612|RESICO.*[Ff]isica|Simplificado.*[Cc]onfianza.*[Ff]isica/i.test(txt)) d.regimenes.push('PF_RESICO');
  if(/606|[Aa]rrendamiento/i.test(txt)&&(d.tipo==='PF'||!d.tipo)) d.regimenes.push('PF_ARR');
  if(/601|General de [Ll]ey [Pp]ersonas [Mm]orales/i.test(txt)) d.regimenes.push('PM_GEN');
  if(/626|RESICO.*[Mm]oral|Simplificado.*[Cc]onfianza.*[Mm]oral/i.test(txt)) d.regimenes.push('PM_RESICO');
  d.actividades=[];
  if(/autotransporte|transporte.*carga|flete/i.test(txt)) d.actividades.push('FLETE');
  if(/honorarios?|servicios\s+profesionales/i.test(txt)) d.actividades.push('HONOR');
  if(/arrendamiento|arrendar/i.test(txt)){
    if(/maquinaria|equipo|mueble/i.test(txt)) d.actividades.push('ARR_MUE');
    else d.actividades.push('ARR_INM');
  }
  if(/comisi[o\u00f3]n|comisionista/i.test(txt)) d.actividades.push('COMIS');
  if(/comercio|venta\s+de|materiales|insumos/i.test(txt)) d.actividades.push('VENTA');
  return d;
}

function aplicar(d){
  var campos=[];
  if(d.tipo) selTipo(d.tipo);
  if(d.rfc){
    if(d.tipo==='PF'){sv('pf-rfc',d.rfc);ma('pf-rfc');}
    else{sv('pm-rfc',d.rfc);ma('pm-rfc');}
    campos.push('RFC: '+d.rfc);
  }
  if(d.curp){sv('pf-curp',d.curp);ma('pf-curp');campos.push('CURP');}
  if(d.cp){
    if(d.tipo==='PF'){sv('pf-cp',d.cp);ma('pf-cp');}
    else{sv('pm-cp',d.cp);ma('pm-cp');}
    campos.push('C.P.: '+d.cp);
  }
  if(d.nombre){
    if(d.tipo==='PF'){
      var pts=d.nombre.split(/\s+/);
      if(pts.length>=3){
        sv('pf-nom',pts.slice(0,-2).join(' '));ma('pf-nom');
        sv('pf-ap',pts[pts.length-2]);ma('pf-ap');
        sv('pf-am',pts[pts.length-1]);ma('pf-am');
      } else {sv('pf-nom',d.nombre);ma('pf-nom');}
    } else {sv('pm-razon',d.nombre);ma('pm-razon');}
    campos.push('Nombre detectado');
  }
  if(d.regimenes.length>0){
    sv2('regimen',d.regimenes[0]);
    var rtxt=document.getElementById('regimen');
    campos.push('Regimen: '+(rtxt.options[rtxt.selectedIndex]?.text||d.regimenes[0]).split('·')[0]);
  }
  if(d.actividades.length>0){
    sv2('actividad',d.actividades[0]);
    campos.push('Actividad detectada');
  }
  calcRet();
  var multR=d.regimenes.length>1,multA=d.actividades.length>1;
  var adv='';
  if(multR) adv+='<br>&#9888; Se detectaron <strong>'+d.regimenes.length+' regimenes</strong>. Verifica y selecciona el correcto.';
  if(multA) adv+='<br>&#9888; Se detectaron <strong>'+d.actividades.length+' actividades</strong>. Confirma cual aplica al servicio contratado.';
  if(campos.length>0){
    muestraRes(multR||multA?'warn':'ok',
      (multR||multA?'&#9888;':'&#10003;')+' Datos extraidos de la CSF - verifica antes de continuar',
      'Se completaron automaticamente: <strong>'+campos.join(', ')+'</strong>. Los campos en verde vienen de la CSF; editables si hay error.'+adv
    );
  } else {
    muestraRes('warn','No se pudieron extraer datos','Formato no estandar. Completa los campos manualmente.');
  }
}

function sv(id,val){var e=document.getElementById(id);if(e)e.value=val;}
function ma(id){var e=document.getElementById(id);if(e)e.classList.add('autorel');}
function sv2(id,val){var e=document.getElementById(id);if(e)e.value=val;}

function muestraRes(tp,tit,msg){
  var el=document.getElementById('csf-res');
  el.className='csf-resultado vis';
  var cls=tp==='ok'?'badge-ok':tp==='warn'?'badge-warn':'badge-err';
  el.innerHTML='<div class="csf-badge '+cls+'">'+tit+'</div><p style="font-size:11.5px;color:var(--g700);line-height:1.55;margin-top:4px;">'+msg+'</p>';
}

function renderPag(n){
  if(!pdfDoc) return;
  pdfPag=Math.max(1,Math.min(n,pdfDoc.numPages));
  pdfDoc.getPage(pdfPag).then(function(pag){
    var vp=pag.getViewport({scale:1.4});
    var canvas=document.getElementById('pdf-canvas');
    var ctx=canvas.getContext('2d');
    canvas.height=vp.height;canvas.width=vp.width;
    pag.render({canvasContext:ctx,viewport:vp}).promise.then(function(){
      document.getElementById('pdf-info').textContent='Pag '+pdfPag+' / '+pdfDoc.numPages;
    });
  });
}
function cambiarPag(d){renderPag(pdfPag+d);}

function irA(n){
  document.querySelectorAll('.paso').forEach(function(p,i){p.classList.toggle('activo',i===n);});
  document.querySelectorAll('.step-tab').forEach(function(t,i){
    t.classList.remove('activo','ok');
    if(i===n) t.classList.add('activo');
    else if(i<n) t.classList.add('ok');
  });
  if(n===2) renderChk();
  window.scrollTo({top:0,behavior:'smooth'});
}

function selTipo(t){
  tipo=t;
  document.getElementById('btn-pf').classList.toggle('sel',t==='PF');
  document.getElementById('btn-pm').classList.toggle('sel',t==='PM');
  document.getElementById('sec-pf').classList.toggle('vis',t==='PF');
  document.getElementById('sec-pm').classList.toggle('vis',t==='PM');
  var sel=document.getElementById('regimen');
  for(var i=0;i<sel.options.length;i++){
    var opt=sel.options[i];
    if(!opt.value) continue;
    var og=opt.parentElement.tagName==='OPTGROUP'?opt.parentElement.label:'';
    opt.hidden=(t==='PF'?og==='Persona Moral':og==='Persona Fisica'||og==='Persona F\u00edsica');
  }
}

function esResico(){var r=document.getElementById('regimen').value;return r==='PF_RESICO'||r==='PM_RESICO';}

function calcRet(){
  var reg=document.getElementById('regimen').value;
  var act=document.getElementById('actividad').value;
  var caja=document.getElementById('ret-resultado');
  if(!reg||!act){caja.className='ret-box vacio';caja.innerHTML='Selecciona regimen y actividad para calcular la retencion';return;}
  var r=RET[tipo]&&RET[tipo][act];
  if(!r){
    caja.className='ret-box alerta';
    caja.innerHTML='<div class="ret-tit am">&#9888; Retencion no determinada automaticamente</div><p style="font-size:12px;color:var(--am-txt);line-height:1.5;">Esta combinacion requiere revision manual del contador.</p>';
    return;
  }
  var resico=esResico();
  var isrVal=resico?r.isr_r:r.isr_n;
  var isrBase=resico?r.isr_rb:r.isr_nb;
  var alerta=!!r.alerta&&!resico;
  caja.className='ret-box'+(alerta?' alerta':'');
  var resHtml='<div class="ret-tit'+(alerta?' am':'')+'">'+
    (alerta?'&#9888;':'&#10003;')+' Retencion aplicable'+
    (resico?' <span style="font-size:10px;background:rgba(45,90,61,.12);border-radius:3px;padding:1px 7px;color:var(--v-osc);font-weight:600;margin-left:4px;">RESICO</span>':'')+
    '</div>'+
    '<div class="ret-filas">'+
      '<div class="ret-f">'+
        '<span class="ret-lbl">Retencion IVA</span>'+
        '<span class="ret-val'+(r.iva?'':' nd')+'">'+( r.iva||'Sin retencion')+'</span>'+
        '<span class="ret-base">'+(r.ivab||'')+'</span>'+
      '</div>'+
      '<div class="ret-f">'+
        '<span class="ret-lbl">Retencion ISR'+(resico?' (RESICO)':'')+'</span>'+
        '<span class="ret-val'+(isrVal?'':' nd')+'">'+( isrVal||'Sin retencion')+'</span>'+
        '<span class="ret-base">'+(isrBase||'')+'</span>'+
      '</div>'+
    '</div>'+
    '<div class="ret-fun'+(alerta?' am':'')+'">'+r.fun+'</div>'+
    (r.nota&&!resico?'<div class="ret-nota">&#9888; '+r.nota+'</div>':'');
  caja.innerHTML=resHtml;
}

