<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alta de Proveedores · CO-CEP-03</title>
<style>
:root{
  --v-osc:#1e3d2b;--v-med:#2d5a3d;--v-sua:#4a7c5e;--v-pal:#d6e8dc;--v-fon:#eef4f0;
  --g900:#1a1a1a;--g700:#444;--g500:#777;--g300:#bbb;--g100:#f4f4f2;
  --am-fon:#fff8e6;--am-bor:#e0b84a;--am-txt:#7a4f00;
  --ro-fon:#fef2f2;--ro-bor:#e57373;--ro-txt:#8b1a1a;
  --rad:6px;--som:0 2px 12px rgba(0,0,0,.07);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:var(--g900);background:#e8ede9;min-height:100vh;padding:0 0 48px;}
.app-header{background:var(--v-osc);color:#fff;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.25);}
.app-header h1{font-size:15px;font-weight:700;}
.app-header .reg{font-size:10px;color:rgba(255,255,255,.45);letter-spacing:.5px;}
.steps-bar{background:var(--v-med);padding:0 28px;display:flex;border-bottom:2px solid var(--v-osc);}
.step-tab{padding:10px 18px;font-size:11.5px;font-weight:600;color:rgba(255,255,255,.45);cursor:pointer;border-bottom:3px solid transparent;display:flex;align-items:center;gap:7px;white-space:nowrap;user-select:none;transition:all .15s;}
.step-tab .num{width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;}
.step-tab.activo{color:#fff;border-bottom-color:#7ecfa0;}
.step-tab.activo .num{background:#7ecfa0;color:var(--v-osc);}
.step-tab.ok .num::after{content:'✓';}
.step-tab.ok{color:rgba(255,255,255,.7);}
.main{max-width:860px;margin:24px auto 0;padding:0 16px;}
.paso{display:none;}
.paso.activo{display:block;}
.card{background:#fff;border-radius:var(--rad);box-shadow:var(--som);margin-bottom:16px;overflow:hidden;}
.card-head{background:var(--v-fon);border-bottom:1px solid var(--v-pal);padding:11px 20px;display:flex;align-items:center;gap:10px;}
.card-head h2{font-size:13px;font-weight:700;color:var(--v-osc);}
.ico{width:28px;height:28px;background:var(--v-med);border-radius:5px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0;}
.card-body{padding:18px 20px;}
.grid{display:grid;gap:14px;}
.g2{grid-template-columns:1fr 1fr;}
.g3{grid-template-columns:1fr 1fr 1fr;}
.s2{grid-column:span 2;}
.s3{grid-column:span 3;}
.campo{display:flex;flex-direction:column;gap:4px;}
.campo label{font-size:11px;font-weight:600;color:var(--g700);text-transform:uppercase;letter-spacing:.4px;}
.campo label .req{color:#c0392b;margin-left:2px;}
.campo label .opc{font-weight:400;color:var(--g500);text-transform:none;letter-spacing:0;font-size:10.5px;}
input,select,textarea{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:var(--g900);background:var(--g100);border:1px solid #ddd;border-radius:var(--rad);padding:8px 10px;width:100%;outline:none;transition:border-color .15s,box-shadow .15s;}
input:focus,select:focus,textarea:focus{border-color:var(--v-sua);box-shadow:0 0 0 3px rgba(74,124,94,.12);background:#fff;}
input.autorel{background:#f0f9f4;border-color:var(--v-pal);}
input.err{border-color:var(--ro-bor);}
textarea{resize:vertical;min-height:56px;}
select{cursor:pointer;}
.hint{font-size:10.5px;color:var(--g500);margin-top:2px;}
.ferr{font-size:10.5px;color:var(--ro-txt);margin-top:2px;display:none;}
.ferr.vis{display:block;}
.csf-zona{border:2px dashed var(--v-pal);border-radius:var(--rad);padding:28px 20px;text-align:center;cursor:pointer;transition:all .2s;background:var(--v-fon);position:relative;}
.csf-zona:hover,.csf-zona.drag{border-color:var(--v-sua);background:#e4f0e9;}
.csf-zona input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
.csf-icon{font-size:32px;margin-bottom:8px;}
.csf-titulo{font-size:13.5px;font-weight:700;color:var(--v-osc);margin-bottom:4px;}
.csf-sub{font-size:11px;color:var(--g500);}
.csf-progress{display:none;margin-top:14px;}
.csf-progress.vis{display:block;}
.prog-bar-wrap{height:6px;background:#ddd;border-radius:3px;overflow:hidden;margin-bottom:6px;}
.prog-bar{height:100%;background:var(--v-med);border-radius:3px;transition:width .3s;width:0%;}
.prog-txt{font-size:11px;color:var(--g500);text-align:center;}
.csf-resultado{display:none;margin-top:14px;}
.csf-resultado.vis{display:block;}
.csf-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:4px;font-size:11px;font-weight:600;margin-bottom:6px;}
.badge-ok{background:#e6f4ec;color:var(--v-osc);}
.badge-warn{background:var(--am-fon);color:var(--am-txt);}
.badge-err{background:var(--ro-fon);color:var(--ro-txt);}
.doble{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;margin-top:16px;}
.pdf-panel{background:var(--g100);border-radius:var(--rad);overflow:hidden;border:1px solid #ddd;}
.pdf-panel canvas{display:block;width:100%;height:auto;}
.pdf-nav{display:flex;align-items:center;justify-content:space-between;padding:6px 10px;background:#fff;border-top:1px solid #ddd;font-size:11px;color:var(--g700);}
.pdf-nav button{padding:3px 10px;border:1px solid #ddd;border-radius:4px;background:#fff;cursor:pointer;font-size:11px;}
.tipo-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px;}
.tipo-btn{border:2px solid #ddd;border-radius:var(--rad);padding:14px;cursor:pointer;text-align:center;transition:all .18s;background:var(--g100);}
.tipo-btn:hover{border-color:var(--v-sua);background:var(--v-fon);}
.tipo-btn.sel{border-color:var(--v-med);background:var(--v-fon);box-shadow:0 0 0 3px rgba(45,90,61,.08);}
.tipo-btn .ti{font-size:22px;margin-bottom:5px;}
.tipo-btn .tl{font-size:12px;font-weight:700;color:var(--v-osc);}
.tipo-btn .td{font-size:10.5px;color:var(--g500);margin-top:2px;}
.sec-pf,.sec-pm{display:none;}
.sec-pf.vis,.sec-pm.vis{display:block;}
.ret-box{border-radius:var(--rad);border:2px solid var(--v-pal);background:var(--v-fon);padding:14px 16px;margin-top:14px;}
.ret-box.alerta{border-color:var(--am-bor);background:var(--am-fon);}
.ret-box.vacio{border-color:#ddd;background:var(--g100);color:var(--g500);font-style:italic;font-size:12px;text-align:center;padding:18px;}
.ret-tit{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--v-osc);margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.ret-tit.am{color:var(--am-txt);}
.ret-filas{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.ret-f{display:flex;flex-direction:column;gap:2px;}
.ret-lbl{font-size:10px;color:var(--g500);text-transform:uppercase;letter-spacing:.4px;}
.ret-val{font-size:18px;font-weight:700;color:var(--v-osc);line-height:1.1;}
.ret-val.nd{font-size:13px;color:var(--g500);font-weight:400;}
.ret-base{font-size:10.5px;color:var(--g500);margin-top:1px;}
.ret-fun{font-size:10px;color:var(--v-sua);margin-top:10px;padding-top:8px;border-top:1px solid var(--v-pal);}
.ret-fun.am{color:var(--am-txt);border-top-color:var(--am-bor);}
.ret-nota{font-size:11px;color:var(--am-txt);background:rgba(224,184,74,.1);border-radius:4px;padding:7px 10px;margin-top:8px;line-height:1.5;}
.chk-item{display:flex;align-items:flex-start;gap:12px;padding:11px 0;border-bottom:1px solid #f0f0ee;}
.chk-item:last-child{border-bottom:none;}
.chk-num{width:22px;height:22px;border-radius:50%;background:var(--v-pal);color:var(--v-osc);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.chk-txt{flex:1;font-size:12.5px;line-height:1.4;}
.chk-ops{display:flex;gap:8px;flex-shrink:0;}
.chk-btn{padding:4px 14px;border-radius:4px;border:1.5px solid #ddd;background:#fff;font-size:11px;font-weight:600;cursor:pointer;color:var(--g700);transition:all .15s;}
.chk-btn.si-s{background:#e6f4ec;border-color:var(--v-sua);color:var(--v-osc);}
.chk-btn.no-s{background:var(--ro-fon);border-color:var(--ro-bor);color:var(--ro-txt);}
.pago-grid{display:flex;gap:10px;margin-bottom:12px;}
.pago-btn{flex:1;padding:9px;border:1.5px solid #ddd;border-radius:var(--rad);background:var(--g100);font-size:12px;font-weight:600;cursor:pointer;color:var(--g700);text-align:center;transition:all .15s;}
.pago-btn.sel{background:var(--v-fon);border-color:var(--v-med);color:var(--v-osc);}
.cred-det{display:none;}
.cred-det.vis{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.firmas{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:4px;}
.firma{display:flex;flex-direction:column;gap:3px;}
.firma-lin{height:36px;border-bottom:1.5px solid var(--g300);}
.firma-n{font-size:10.5px;font-weight:700;color:var(--g700);margin-top:4px;text-align:center;}
.firma-c{font-size:10px;color:var(--g500);text-align:center;}
.nav-btns{display:flex;justify-content:space-between;align-items:center;margin-top:20px;padding-top:14px;border-top:1px solid #e8e8e6;}
.btn{padding:10px 22px;border-radius:var(--rad);border:none;font-family:'Segoe UI',Arial,sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:7px;}
.btn-p{background:var(--v-med);color:#fff;}
.btn-p:hover{background:var(--v-osc);}
.btn-s{background:var(--g100);color:var(--g700);border:1px solid #ddd;}
.btn-s:hover{background:#eee;}
.btn-i{background:var(--v-osc);color:#fff;padding:10px 28px;}
.btn-i:hover{background:#111;}
.btn-n{background:#fff;color:var(--v-osc);border:1.5px solid var(--v-med);}
.btn-n:hover{background:var(--v-fon);}
.fich-head{background:var(--v-osc);color:#fff;border-radius:var(--rad) var(--rad) 0 0;padding:16px 22px;display:flex;justify-content:space-between;align-items:flex-start;}
.fich-head h2{font-size:14px;font-weight:700;}
.fich-head .freg{font-size:10px;color:rgba(255,255,255,.45);margin-top:2px;}
.fich-head .ffec{font-size:11px;color:rgba(255,255,255,.6);text-align:right;}
.fich-body{background:#fff;border:1px solid var(--v-pal);border-top:none;border-radius:0 0 var(--rad) var(--rad);padding:18px 22px;box-shadow:var(--som);margin-bottom:16px;}
.res-sec{margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid #f0f0ee;}
.res-sec:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0;}
.res-sec-tit{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--v-sua);margin-bottom:8px;}
.res-campos{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 16px;}
.res-c{display:flex;flex-direction:column;gap:2px;}
.res-lbl{font-size:10px;color:var(--g500);}
.res-val{font-size:12.5px;color:var(--g900);font-weight:500;word-break:break-word;}
.ret-duo{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px;}
.ret-d{background:var(--v-fon);border:1.5px solid var(--v-pal);border-radius:5px;padding:10px 14px;}
.ret-d.am{background:var(--am-fon);border-color:var(--am-bor);}
.ret-d-lbl{font-size:10px;color:var(--g500);text-transform:uppercase;letter-spacing:.4px;}
.ret-d-val{font-size:20px;font-weight:700;color:var(--v-osc);line-height:1.1;margin-top:2px;}
.ret-d-val.nd{font-size:13px;color:var(--g500);font-weight:400;}
.ret-d-val.am{color:var(--am-txt);}
.ret-d-base{font-size:10px;color:var(--g500);margin-top:1px;}
.ret-d-fun{font-size:10px;color:var(--v-sua);margin-top:6px;}
.alerta-c{background:var(--am-fon);border:1.5px solid var(--am-bor);border-radius:5px;padding:10px 14px;margin-top:8px;font-size:11.5px;color:var(--am-txt);line-height:1.5;}
@media print{
  body{background:#fff;padding:0;font-size:11px;}
  .app-header,.steps-bar,.nav-btns,.no-print,.csf-zona,.csf-progress,.doble{display:none!important;}
  .paso{display:block!important;}
  .main{max-width:100%;margin:0;padding:10mm 14mm;}
  .card{box-shadow:none;border:1px solid #ccc;margin-bottom:8px;}
  .fich-head,.ret-d,.ret-box{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  @page{size:A4 portrait;margin:0;}
}
@media(max-width:640px){
  .g2,.g3{grid-template-columns:1fr;}
  .s2,.s3{grid-column:span 1;}
  .tipo-grid,.doble,.firmas,.ret-duo{grid-template-columns:1fr;}
  .res-campos{grid-template-columns:1fr 1fr;}
  .steps-bar{overflow-x:auto;}
  .step-tab{font-size:10px;padding:10px 10px;}
}
</style>
</head>
<body>
<div class="app-header">
  <div><h1>Alta de Proveedores</h1><div class="reg">REGISTRO DE SGC: CO-CEP-03</div></div>
  <div style="font-size:11px;color:rgba(255,255,255,.45);">POMOCA-IA &middot; Herramientas Internas &middot; Contabilidad</div>
</div>
<div class="steps-bar">
  <div class="step-tab activo" onclick="irA(0)"><span class="num">1</span> CSF y retenci&oacute;n</div>
  <div class="step-tab" onclick="irA(1)"><span class="num">2</span> Datos fiscales</div>
  <div class="step-tab" onclick="irA(2)"><span class="num">3</span> Documentaci&oacute;n</div>
  <div class="step-tab" onclick="irA(3)"><span class="num">4</span> Ficha final</div>
</div>
<div class="main">

<div class="paso activo" id="paso-0">
  <div class="card">
    <div class="card-head"><div class="ico">&#128196;</div><h2>Constancia de Situaci&oacute;n Fiscal (CSF)</h2></div>
    <div class="card-body">
      <div class="csf-zona" id="csf-zona"
        ondragover="event.preventDefault();this.classList.add('drag')"
        ondragleave="this.classList.remove('drag')"
        ondrop="onDrop(event)">
        <input type="file" accept="application/pdf" onchange="procesarCSF(this.files[0])">
        <div class="csf-icon">&#128194;</div>
        <div class="csf-titulo">Arrastra la CSF aqu&iacute; o haz clic para seleccionarla</div>
        <div class="csf-sub">Solo archivos PDF &middot; El archivo nunca sale de tu navegador</div>
      </div>
      <div class="csf-progress" id="csf-prog">
        <div class="prog-bar-wrap"><div class="prog-bar" id="prog-bar"></div></div>
        <div class="prog-txt" id="prog-txt">Leyendo PDF&hellip;</div>
      </div>
      <div class="csf-resultado" id="csf-res"></div>
      <div id="panel-doble" style="display:none">
        <div class="doble">
          <div class="pdf-panel">
            <canvas id="pdf-canvas"></canvas>
            <div class="pdf-nav">
              <button onclick="cambiarPag(-1)">&#9664;</button>
              <span id="pdf-info">P&aacute;g 1 / 1</span>
              <button onclick="cambiarPag(1)">&#9654;</button>
            </div>
          </div>
          <div style="font-size:12px;color:var(--g700);line-height:1.6;padding-top:8px;">
            <strong>PDF escaneado.</strong><br>
            Captura los datos manualmente en los campos de abajo.<br>
            Usa el visor de la izquierda como referencia.
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-head"><div class="ico">&#128100;</div><h2>Tipo de persona y retenci&oacute;n</h2></div>
    <div class="card-body">
      <div class="tipo-grid">
        <div class="tipo-btn sel" id="btn-pf" onclick="selTipo('PF')">
          <div class="ti">&#129489;</div><div class="tl">Persona F&iacute;sica</div><div class="td">RFC 13 d&iacute;gitos &middot; CURP</div>
        </div>
        <div class="tipo-btn" id="btn-pm" onclick="selTipo('PM')">
          <div class="ti">&#127970;</div><div class="tl">Persona Moral</div><div class="td">RFC 12 d&iacute;gitos &middot; Raz&oacute;n social</div>
        </div>
      </div>
      <div class="grid g2">
        <div class="campo">
          <label>R&eacute;gimen fiscal <span class="req">*</span></label>
          <select id="regimen" onchange="calcRet()">
            <option value="">&#8212; Seleccionar r&eacute;gimen (de la CSF) &#8212;</option>
            <optgroup label="Persona F&iacute;sica">
              <option value="PF_RESICO">612 &middot; RESICO Persona F&iacute;sica</option>
              <option value="PF_ACT">612 &middot; Actividades Empresariales y Profesionales</option>
              <option value="PF_ARR">606 &middot; Arrendamiento</option>
              <option value="PF_SIN">616 &middot; Sin obligaciones fiscales</option>
              <option value="PF_OTR">Otro r&eacute;gimen PF</option>
            </optgroup>
            <optgroup label="Persona Moral">
              <option value="PM_GEN">601 &middot; General de Ley PM</option>
              <option value="PM_RESICO">626 &middot; RESICO PM</option>
              <option value="PM_SFL">603 &middot; Fines no lucrativos</option>
              <option value="PM_OTR">Otro r&eacute;gimen PM</option>
            </optgroup>
          </select>
          <span class="hint">Si la CSF trae varios reg&iacute;menes, verifica y selecciona el principal</span>
        </div>
        <div class="campo">
          <label>Actividad que nos factura <span class="req">*</span></label>
          <select id="actividad" onchange="calcRet()">
            <option value="">&#8212; Seleccionar actividad &#8212;</option>
            <option value="HONOR">Honorarios / Servicios profesionales</option>
            <option value="ARR_INM">Arrendamiento de inmueble</option>
            <option value="ARR_MUE">Arrendamiento de maquinaria / equipo</option>
            <option value="FLETE">Autotransporte terrestre de carga (fletes)</option>
            <option value="COMIS">Comisiones mercantiles</option>
            <option value="VENTA">Venta de bienes / materiales / insumos</option>
            <option value="OTRO">Otro / No clasificado</option>
          </select>
          <span class="hint">Si la CSF trae varias actividades, confirmar cu&aacute;l aplica al servicio contratado</span>
        </div>
      </div>
      <div id="ret-resultado" class="ret-box vacio">Selecciona r&eacute;gimen y actividad para calcular la retenci&oacute;n</div>
    </div>
  </div>
  <div class="nav-btns no-print"><div></div><button class="btn btn-p" onclick="irA(1)">Siguiente &rarr; Datos fiscales</button></div>
</div>

<div class="paso" id="paso-1">
  <div class="sec-pf vis" id="sec-pf">
    <div class="card">
      <div class="card-head"><div class="ico">&#129489;</div><h2>Datos de la persona f&iacute;sica</h2></div>
      <div class="card-body">
        <div class="grid g3">
          <div class="campo"><label>Nombre(s) <span class="req">*</span></label><input type="text" id="pf-nom" placeholder="Nombre(s)"></div>
          <div class="campo"><label>Apellido paterno <span class="req">*</span></label><input type="text" id="pf-ap" placeholder="Apellido paterno"></div>
          <div class="campo"><label>Apellido materno <span class="opc">(opc.)</span></label><input type="text" id="pf-am" placeholder="Apellido materno"></div>
          <div class="campo">
            <label>RFC <span class="req">*</span> <span class="opc">13 d&iacute;gitos</span></label>
            <input type="text" id="pf-rfc" placeholder="XXXX000000XXX" maxlength="13" oninput="this.value=this.value.toUpperCase()" onblur="valRFC('pf')">
            <span class="ferr" id="err-pf">RFC inv&aacute;lido &mdash; deben ser 13 caracteres</span>
          </div>
          <div class="campo"><label>CURP <span class="req">*</span> <span class="opc">18 d&iacute;gitos</span></label><input type="text" id="pf-curp" placeholder="XXXX000000XXXXXX00" maxlength="18" oninput="this.value=this.value.toUpperCase()"></div>
          <div class="campo"><label>C.P. fiscal <span class="req">*</span></label><input type="text" id="pf-cp" placeholder="00000" maxlength="5"></div>
          <div class="campo s3"><label>Domicilio fiscal <span class="opc">(opc.)</span></label><input type="text" id="pf-dom" placeholder="Calle, n&uacute;mero, colonia, municipio, estado"></div>
          <div class="campo">
            <label>Uso de CFDI</label>
            <select id="pf-cfdi">
              <option value="">&#8212; Seleccionar &#8212;</option>
              <option value="G01">G01 &middot; Adquisici&oacute;n de mercancias</option>
              <option value="G03">G03 &middot; Gastos en general</option>
