      '<div class="res-sec">'+
        '<div class="res-sec-tit">Firmas de autorizacion</div>'+
        '<div class="firmas">'+
          '<div class="firma"><div class="firma-lin"></div><div class="firma-n">LIC. JOSE ALVARO ALVAREZ CERINO</div><div class="firma-c">Coordinacion de adquisiciones - Integro</div></div>'+
          '<div class="firma"><div class="firma-lin"></div><div class="firma-n">C.P. MARIA DEL ROSARIO SEVERIANO H.</div><div class="firma-c">Gerente de Administracion y finanzas - Reviso</div></div>'+
          '<div class="firma"><div class="firma-lin"></div><div class="firma-n">ING. GUSTAVO CARRERA FALCON</div><div class="firma-c">Director general - Autorizo</div></div>'+
        '</div>'+
      '</div>'+
    '</div></div>';
  irA(3);
}

function nuevoRegistro(){
  document.querySelectorAll('input,textarea').forEach(function(e){e.value='';e.classList.remove('autorel','err');});
  document.querySelectorAll('select').forEach(function(e){e.selectedIndex=0;});
  document.getElementById('csf-res').className='csf-resultado';
  document.getElementById('csf-prog').className='csf-progress';
  document.getElementById('panel-doble').style.display='none';
  pdfDoc=null;
  selTipo('PF');selPago('contado');calcRet();irA(0);
}

selTipo('PF');renderChk();
