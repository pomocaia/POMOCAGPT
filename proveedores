          '<div class="res-c"><span class="res-lbl">RFC</span><span class="res-val">'+rfc+'</span></div>'+
          curpHtml+
          '<div class="res-c"><span class="res-lbl">C.P. fiscal</span><span class="res-val">'+cp+'</span></div>'+
          '<div class="res-c" style="grid-column:span 3"><span class="res-lbl">Domicilio fiscal</span><span class="res-val">'+dom+'</span></div>'+
          '<div class="res-c"><span class="res-lbl">Regimen fiscal</span><span class="res-val">'+regimenTxt+'</span></div>'+
          '<div class="res-c"><span class="res-lbl">Actividad facturada</span><span class="res-val">'+actTxt+'</span></div>'+
          '<div class="res-c"><span class="res-lbl">Uso de CFDI</span><span class="res-val">'+cfdi+'</span></div>'+
          '<div class="res-c"><span class="res-lbl">Moneda</span><span class="res-val">'+mon+'</span></div>'+
          '<div class="res-c"><span class="res-lbl">CLABE</span><span class="res-val">'+clabe+'</span></div>'+
        '</div>'+
      '</div>'+
      '<div class="res-sec">'+
        '<div class="res-sec-tit">Tasas de retencion</div>'+
        '<div class="ret-duo">'+
          '<div class="ret-d">'+
            '<div class="ret-d-lbl">Retencion IVA</div>'+
            '<div class="ret-d-val'+(r&&r.iva?'':' nd')+'">'+(r&&r.iva?r.iva:'Sin retencion')+'</div>'+
            '<div class="ret-d-base">'+(r?r.ivab:'')+'</div>'+
          '</div>'+
