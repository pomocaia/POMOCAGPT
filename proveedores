    HONOR:{iva:null,ivab:'PM-PM: sin retencion IVA',isr_r:null,isr_rb:null,isr_n:null,isr_nb:'PM-PM: sin retencion ISR',fun:'Sin supuesto de retencion PM-PM'},
    ARR_INM:{iva:null,ivab:'PM-PM: sin retencion IVA',isr_r:null,isr_rb:null,isr_n:null,isr_nb:'PM-PM: sin retencion ISR',fun:'Sin supuesto de retencion PM-PM'},
    ARR_MUE:{iva:null,ivab:'PM-PM: sin retencion IVA',isr_r:null,isr_rb:null,isr_n:null,isr_nb:'PM-PM: sin retencion ISR',fun:'Sin supuesto de retencion PM-PM'},
    COMIS:{iva:null,ivab:'PM-PM: sin retencion IVA',isr_r:null,isr_rb:null,isr_n:null,isr_nb:'PM-PM: sin retencion ISR',fun:'Sin supuesto de retencion PM-PM'},
