    ARR_MUE:{iva:'10.6667%',ivab:'2/3 del IVA trasladado',isr_r:'1.25%',isr_rb:'s/ contraprestacion',isr_n:null,isr_nb:'Art. 116 LISR aplica solo a inmuebles',fun:'Art. 1-A fr.II a) LIVA - Art. 113-J LISR (RESICO)'},
    FLETE:{iva:'4%',ivab:'s/ contraprestacion (no s/ IVA)',isr_r:'1.25%',isr_rb:'s/ contraprestacion',isr_n:null,isr_nb:null,fun:'Art. 1-A fr.II c) LIVA - Art. 3 fr.II RLIVA - Art. 113-J LISR',alerta:true,nota:'ISR para transportistas no RESICO: verificar si aplican Facilidades Administrativas 2026 del sector autotransporte (punto A pendiente con el contador).'},
