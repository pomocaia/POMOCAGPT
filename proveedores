  document.getElementById('cred-det').classList.toggle('vis',p==='credito');
}

function valRFC(t){
  var id=t==='pf'?'pf-rfc':'pm-rfc';
  var eid='err-'+t;
  var len=t==='pf'?13:12;
  var v=document.getElementById(id).value.trim();
  var ok=!v||v.length===len;
  document.getElementById(id).classList.toggle('err',!ok);
  document.getElementById(eid).classList.toggle('vis',!ok);
}

function renderChk(){
  document.getElementById('chk-cont').innerHTML=DOCS.map(function(d){
    var txt=d.txt||(tipo==='PF'?d.pf:d.pm);
    return '<div class="chk-item"><div class="chk-num">'+d.id+'</div><div class="chk-txt">'+txt+'</div>'+
      '<div class="chk-ops">'+
      '<button class="chk-btn" id="si-'+d.id+'" onclick="selDoc('+d.id+',\'SI\')">SI</button>'+
      '<button class="chk-btn" id="no-'+d.id+'" onclick="selDoc('+d.id+',\'NO\')">NO</button>'+
      '</div></div>';
  }).join('');
}
function selDoc(id,v){
  document.getElementById('si-'+id).className='chk-btn'+(v==='SI'?' si-s':'');
  document.getElementById('no-'+id).className='chk-btn'+(v==='NO'?' no-s':'');
}
function getDoc(id){
  if(document.getElementById('si-'+id)&&document.getElementById('si-'+id).classList.contains('si-s')) return 'SI';
  if(document.getElementById('no-'+id)&&document.getElementById('no-'+id).classList.contains('no-s')) return 'NO';
  return '---';
}

function gv(id){var e=document.getElementById(id);return e?e.value||'---':'---';}
function gs(id){var e=document.getElementById(id);return e?(e.options[e.selectedIndex]?e.options[e.selectedIndex].text:'---'):'---';}

