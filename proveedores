          '<div class="res-c"><span class="res-lbl">Contabilidad - Tel</span><span class="res-val">'+gv('co-t')+'</span></div>'+
          '<div class="res-c" style="grid-column:span 3"><span class="res-lbl">Materiales o servicios</span><span class="res-val">'+gv('materiales')+'</span></div>'+
        '</div>'+
      '</div>'+
      '<div class="res-sec">'+
        '<div class="res-sec-tit">Documentacion</div>'+
        docsHTML+
